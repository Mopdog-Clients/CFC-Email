# Copy this file to .email-test.env and add the AWS SES credentials that are
# approved for internal CFC email testing. Never commit .email-test.env.

# The SES region where the sender identity is verified. Usually us-east-2 for MD.
AWS_REGION=us-east-2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave blank unless these are temporary AWS credentials.
AWS_SESSION_TOKEN=

# This address (or its domain) must be verified in Amazon SES.
SES_TEST_FROM_EMAIL=email-sender@mopdogdigital.com
# Optional. Defaults to "CFC Email Test" if omitted.
SES_TEST_FROM_NAME=Mopdog Digital - Email Sender
# Optional address used when a recipient replies to a test email.
SES_TEST_REPLY_TO_EMAIL=support@mopdogdigital.com

# Comma-separated internal recipients. If the SES account is still in its
# sandbox, each recipient must also be a verified SES identity.
SES_TEST_PERSONAL_RECIPIENTS=
SES_TEST_TEAM_RECIPIENTS=
